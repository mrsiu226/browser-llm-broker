# Copy this file to `.env` and edit it. NEVER commit `.env` (it is git-ignored).
# Lines starting with `#` are comments. See docs/DEPLOYMENT.md for the full explanation.

# --- Required ---------------------------------------------------------------
# Secret used to encrypt stored channel credentials (Telegram tokens, webhook headers)
# and to sign image links. Generate one:  openssl rand -hex 32
# The server refuses to start while this is empty, short, or still a "change-me" placeholder.
SECRET_KEY=

# First administrator. Only used when the database is empty (first start).
# If ADMIN_PASSWORD is left empty a random password is generated and printed in the log.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- HTTPS / reverse proxy (production) ------------------------------------
# Public host name served by the bundled Caddy (automatic HTTPS). DNS must point at this server.
DOMAIN=broker.example.com
# 1 when the dashboard is served over HTTPS (marks the session cookie Secure).
COOKIE_SECURE=1
# 1 when the broker sits behind a reverse proxy (Caddy/nginx): trust X-Forwarded-For for rate limits.
TRUST_PROXY=1

# --- Optional ---------------------------------------------------------------
# Days to keep finished jobs and their images.
RETENTION_DAYS=14
# Public base URL used for image links inside webhook payloads (default: https://$DOMAIN).
# BASE_URL=https://broker.example.com
# Allow webhooks to private/internal addresses (default: blocked, to prevent SSRF).
# WEBHOOK_ALLOW_PRIVATE=1
# Max time MCP tools wait for a result before returning a job id (ms).
# MCP_WAIT_MS=90000
# Queued jobs fail after this long without an available device (ms; schedules wait 30 min).
# QUEUE_TIMEOUT_MS=600000
# Daily schedules missed (server down) are still run if within this many minutes.
# CATCH_UP_MINUTES=120
